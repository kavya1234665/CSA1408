%{
#include <stdio.h>
%}

%%
[A-Za-z][A-Za-z0-9._]*@[A-Za-z0-9.-]+\.[A-Za-z]{2,}   { printf("Valid Email Address\n"); }
.*                                                  { printf("Invalid Email Address\n"); }
%%

int yywrap()
{
    return 1;
}

int main()
{
    printf("Enter Email Address: ");
    yylex();
    return 0;
}
