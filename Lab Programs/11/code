#include <stdio.h>
#include <string.h>

struct Symbol {
    char name[20];
    char type[20];
    int address;
};

struct Symbol table[20];
int n = 0;

void insert()
{
    printf("Enter symbol name: ");
    scanf("%s", table[n].name);

    printf("Enter data type: ");
    scanf("%s", table[n].type);

    table[n].address = 1000 + n * 4;
    n++;

    printf("Symbol inserted successfully.\n");
}

void search()
{
    char name[20];
    int i, found = 0;

    printf("Enter symbol to search: ");
    scanf("%s", name);

    for(i = 0; i < n; i++)
    {
        if(strcmp(table[i].name, name) == 0)
        {
            printf("\nSymbol Found\n");
            printf("Name    : %s\n", table[i].name);
            printf("Type    : %s\n", table[i].type);
            printf("Address : %d\n", table[i].address);
            found = 1;
            break;
        }
    }

    if(!found)
        printf("Symbol not found.\n");
}

void display()
{
    int i;

    printf("\nSymbol Table\n");
    printf("-----------------------------\n");
    printf("Name\tType\tAddress\n");

    for(i = 0; i < n; i++)
        printf("%s\t%s\t%d\n",
               table[i].name,
               table[i].type,
               table[i].address);
}

int main()
{
    int choice;

    do
    {
        printf("\n1. Insert\n");
        printf("2. Search\n");
        printf("3. Display\n");
        printf("4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1: insert(); break;
            case 2: search(); break;
            case 3: display(); break;
            case 4: printf("Exiting...\n"); break;
            default: printf("Invalid choice.\n");
        }

    } while(choice != 4);

    return 0;
}
