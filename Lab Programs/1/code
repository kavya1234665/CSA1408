%{
#include <stdio.h>
%}

ID      [a-zA-Z_][a-zA-Z0-9_]{0,29}
CONST   [0-9]+
OP      [+\-*/%=<>]

%%

"//".*                  ;
"/*"([^*]|\*+[^*/])*\*+"/"  ;

[ \t\n]+                ;

{ID}                    { printf("IDENTIFIER : %s\n", yytext); }

{CONST}                 { printf("CONSTANT   : %s\n", yytext); }

{OP}                    { printf("OPERATOR   : %s\n", yytext); }

.                       { printf("UNKNOWN    : %s\n", yytext); }

%%

int yywrap()
{
    return 1;
}

int main()
{
    printf("LEXICAL ANALYZER\n");
    printf("================\n");
    printf("Enter C program:\n");

    yylex();

    return 0;
}
