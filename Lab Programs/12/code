#include <stdio.h>
#include <ctype.h>

char input[100];
int pos = 0;

int E();
int E1();
int T();
int T1();
int F();

int E()
{
    return T() && E1();
}

int E1()
{
    if(input[pos] == '+')
    {
        pos++;
        return T() && E1();
    }

    return 1;
}

int T()
{
    return F() && T1();
}

int T1()
{
    if(input[pos] == '*')
    {
        pos++;
        return F() && T1();
    }

    return 1;
}

int F()
{
    if(isalpha(input[pos]))
    {
        pos++;
        return 1;
    }

    if(input[pos] == '(')
    {
        pos++;

        if(E() && input[pos] == ')')
        {
            pos++;
            return 1;
        }
    }

    return 0;
}

int main()
{
    printf("Enter expression: ");
    scanf("%s", input);

    if(E() && input[pos] == '\0')
        printf("String Accepted\n");
    else
        printf("String Rejected\n");

    return 0;
}
