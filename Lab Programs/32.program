%{
#include<stdio.h>

int pos = 0, neg = 0;
%}

%%
"+"?[0-9]+    { pos++; printf("Positive Number: %s\n", yytext); }
"-"[0-9]+    { neg++; printf("Negative Number: %s\n", yytext); }
[ \t\n]+     ;
.            ;
%%

int yywrap()
{
    return 1;
}

int main()
{
    printf("Enter numbers (Press Ctrl+Z and Enter to finish):\n");
    yylex();

    printf("\nTotal Positive Numbers = %d\n", pos);
    printf("Total Negative Numbers = %d\n", neg);

    return 0;
}
